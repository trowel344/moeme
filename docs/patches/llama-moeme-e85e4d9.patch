+    // Optional MoEMe calibration capture. Store the normalized input to each
+    // dense FFN gate as chunked F32 matrices without changing normal imatrix
+    // behavior. A fresh output directory is required for each campaign.
+    if (const char * capture_dir = getenv("MOEME_CAPTURE_DIR")) {
+        // Dense layers expose the normalized FFN input at ffn_gate.weight.
+        // Converted MoE layers expose the same pre-routing input at
+        // ffn_gate_inp.weight; expert inputs are selected/repeated and are not
+        // a valid replacement for the original token rows.
+        static const std::regex ffn_gate_pattern(
+            R"(^blk\.(\d+)\.ffn_gate(?:_inp)?\.weight$)");
+        std::smatch match;
+        const char * capture_layer = getenv("MOEME_CAPTURE_LAYER");
+        if (std::regex_match(wname, match, ffn_gate_pattern) &&
+            (!capture_layer || match[1].str() == capture_layer)) {
+            const uint32_t n_embd = src1->ne[0];
+            const uint32_t n_tokens = ggml_nrows(src1);
+            std::filesystem::create_directories(capture_dir);
+            const auto path = std::filesystem::path(capture_dir) /
+                ("layer-" + match[1].str() + ".f32");
+            const bool needs_header = !std::filesystem::exists(path) ||
+                std::filesystem::file_size(path) == 0;
+            std::ofstream capture(path, std::ios::binary | std::ios::app);
+            if (needs_header) {
+                constexpr uint32_t magic = 0x4d4f454d; // "MOEM"
+                constexpr uint32_t version = 1;
+                capture.write(reinterpret_cast<const char *>(&magic), sizeof(magic));
